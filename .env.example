# ============================================================================
# ElektroSmartPro — Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================================

# --- Supabase (Database & Auth) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe (Payments) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Price IDs (optional — if set, used instead of inline price_data)
# Create in Stripe Dashboard → Products → Add product → Add price
# Monthly: 159 PLN/month recurring  |  Yearly: 1590 PLN/year recurring
STRIPE_PRICE_MONTHLY_ID=price_...
STRIPE_PRICE_YEARLY_ID=price_...

# Stripe Tax Rate IDs (optional — for manual VAT rate attachment)
# Create in Stripe Dashboard → Tax rates → Add tax rate
# If NOT set, automatic_tax is used instead (requires Stripe Tax registration)
STRIPE_TAX_RATE_8_ID=txr_...
STRIPE_TAX_RATE_23_ID=txr_...

# --- OpenAI (AI Features) ---
OPENAI_API_KEY=sk-...

# --- Resend (Email) ---
RESEND_API_KEY=re_...

# --- VAPID (Push Notifications) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# --- LiveKit (Real-time Audio/Video) ---
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
NEXT_PUBLIC_LIVEKIT_URL=wss://your-livekit-url

# --- InFakt (Polish Invoice Service) ---
INFAKT_API_KEY=your-infakt-api-key

# --- App Configuration ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Sentry (Error Monitoring) ---
NEXT_PUBLIC_SENTRY_DSN=https://your-key@sentry.io/your-project-id
SENTRY_ORG=elektrosmart
SENTRY_PROJECT=elektrosmart-pro

# --- Cron Jobs ---
CRON_SECRET=your-cron-secret

# --- AI Model Override (optional — for hot-swap when preview model is deprecated) ---
# Set to a stable model name to override Tier 1 without code change + redeploy
# E.g., AI_MODEL_TIER1_OVERRIDE=gemini-2.5-flash
AI_MODEL_TIER1_OVERRIDE=

# --- Google AI (Knowledge Base — Gemini 2.0 Flash, Context Caching) ---
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=your-google-ai-api-key

# --- Google Generative AI (@ai-sdk/google — Panel Configurator AI uses Gemini 2.0 Flash) ---
# Same key as above — copy from https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-api-key

# --- Upstash Redis (Rate Limiting for /api/ai/* and /api/admin/*) ---
# Create free Redis at https://console.upstash.com → REST API
# If NOT set, rate limiting falls back to allow-all (dev mode)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# --- Admin Email (for finance-actions.ts admin check) ---
ADMIN_EMAIL=your-admin@email.com

# --- Admin API Secret (protects /api/admin/* routes) ---
# Generate with: openssl rand -hex 32
ADMIN_SECRET=your-admin-secret-min-32-chars
